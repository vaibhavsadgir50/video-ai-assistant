# Copy this file to .env and fill in your own keys.
# cp .env.example .env

# Mistral API — used by core/summarize.py if you switch the LLM provider to Mistral
MISTRAL_API_KEY=

# OpenRouter API — default LLM provider for summarization, extraction and the RAG chat
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Whisper model size for local English transcription (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Sarvam AI — speech-to-text-translate API, used for Hindi / Hinglish audio
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2.5
